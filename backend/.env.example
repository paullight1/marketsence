ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./marketsense.db
ALLOWED_ORIGINS=["http://localhost:3000"]
SQL_ECHO=false

AUTH_ENABLED=false
AUTH_SECRET=
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_ROLE=admin
AUTH_TOKEN_TTL_MINUTES=30

RATE_LIMIT_ENABLED=false
REDIS_URL=
AUTH_LOGIN_LIMIT_PER_MINUTE=5
READ_LIMIT_PER_MINUTE=120
WRITE_LIMIT_PER_MINUTE=30

BACKGROUND_JOBS_ENABLED=true
SYNC_INGEST_MAX_LISTINGS=100
JOB_LEASE_SECONDS=120
JOB_DEFAULT_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=5
JOB_POLL_SECONDS=1

MAX_CSV_UPLOAD_BYTES=5242880
CLEANED_CSV_RETENTION_HOURS=24
MAX_CLEANED_CSV_EXPORTS=50
EXPORT_STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_PREFIX=cleaned-exports
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MAX_SCRAPE_RESPONSE_BYTES=2097152
SCRAPE_TIMEOUT_SECONDS=15
MAX_SCRAPE_REDIRECTS=5
SCRAPE_ALLOWED_DOMAINS=[]
BROWSER_SCRAPER_ENABLED=false
BROWSER_SCRAPE_ALLOWED_DOMAINS=[]
