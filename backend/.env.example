ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./marketsense.db
ALLOWED_ORIGINS=["http://localhost:3000"]
SQL_ECHO=false

# Authentication is bearer-token based. Production requires all of these.
AUTH_ENABLED=false
AUTH_SECRET=
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_ROLE=admin
AUTH_TOKEN_TTL_MINUTES=30

# Distributed rate limiting. Production requires RATE_LIMIT_ENABLED=true and REDIS_URL.
RATE_LIMIT_ENABLED=false
REDIS_URL=
AUTH_LOGIN_LIMIT_PER_MINUTE=5
READ_LIMIT_PER_MINUTE=120
WRITE_LIMIT_PER_MINUTE=30

# Ingestion safety limits
MAX_CSV_UPLOAD_BYTES=5242880
CLEANED_CSV_RETENTION_HOURS=24
MAX_CLEANED_CSV_EXPORTS=50
MAX_SCRAPE_RESPONSE_BYTES=2097152
SCRAPE_TIMEOUT_SECONDS=15
MAX_SCRAPE_REDIRECTS=5

# Leave empty for development. Production policy is tightened in the egress gate.
SCRAPE_ALLOWED_DOMAINS=[]

# Browser automation is disabled by default because browser navigation cannot enforce
# the same redirect-level network checks as the HTTP scraper. Enable only for trusted domains.
BROWSER_SCRAPER_ENABLED=false
BROWSER_SCRAPE_ALLOWED_DOMAINS=[]
